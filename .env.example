# ---------------------------------------------------------------------------
# Combolo – environment variables. Copy to .env (never commit real keys).
# Every provider key is optional: the app uses whatever you configure and reports
# what is missing on /data-sources. See README.md for how to obtain each key.
# ---------------------------------------------------------------------------

# --- Database (required) ----------------------------------------------------
# Local:    postgresql://combolo:combolo@localhost:5432/combolo
# Supabase: use the *pooled* connection string for the app, direct for migrations (see README)
# Neon:     postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL="postgresql://combolo:combolo@localhost:5432/combolo"
# Used by `npm run test:integration` and Playwright. Must end in _test (the tests refuse anything else).
# If unset it is derived from DATABASE_URL by appending _test to the database name.
TEST_DATABASE_URL="postgresql://combolo:combolo@localhost:5432/combolo_test"

# --- Site -------------------------------------------------------------------
SITE_NAME="Combolo"
SITE_URL="http://localhost:3000"
# Default time zone for stored combos and the 3-calendar-day window. Visitors can change theirs in the header.
DEFAULT_TIMEZONE="America/Chicago"

# --- Compliance -------------------------------------------------------------
AGE_GATE_ENABLED=true
# 18 or 21 (any whole number from 18 to 25 is accepted)
AGE_GATE_MIN_AGE=18

# --- Scheduling -------------------------------------------------------------
# Required for the Vercel Cron / external-cron endpoint /api/cron/<job>. Generate with: openssl rand -hex 32
# Vercel sends it automatically as "Authorization: Bearer <CRON_SECRET>" when the variable is set.
CRON_SECRET=

# --- Quota manager ----------------------------------------------------------
# Calls always kept unused in every daily/monthly provider bucket as a safety margin.
QUOTA_SAFETY_RESERVE=3

# --- football-data.org (football; free tier = 12 competitions, 10 req/min) ---
# https://www.football-data.org/client/register
FOOTBALL_DATA_KEY=
FOOTBALL_DATA_MINUTE_LIMIT=10

# --- API-Sports (football, basketball, hockey, baseball, american-football, rugby, handball, volleyball) ---
# https://dashboard.api-sports.io/register  (one key works for every sport API)
APISPORTS_KEY=
# Free plan: 100 requests/day PER sport API, 10/min. Set true if your dashboard shows ONE shared counter.
APISPORTS_SHARED_QUOTA=false
APISPORTS_DAILY_LIMIT=100
APISPORTS_MINUTE_LIMIT=10

# --- Highlightly (multi-sport; one subscription per sport on RapidAPI/Highlightly) ---
# https://highlightly.net/documentation
HIGHLIGHTLY_KEY=
HIGHLIGHTLY_DAILY_LIMIT=100
HIGHLIGHTLY_MINUTE_LIMIT=20

# --- TheSportsDB (names, badges, schedules only). "3" is the public free key (limited to ~15 events/day/sport) ---
THESPORTSDB_KEY=3
THESPORTSDB_MINUTE_LIMIT=25

# --- Tennis --------------------------------------------------------------------
# API-Tennis (results, rankings, H2H, odds): https://api-tennis.com
API_TENNIS_KEY=
API_TENNIS_MONTHLY_LIMIT=1000
API_TENNIS_DAILY_BUDGET=30
# Live Tennis API (fixtures, surfaces, player rankings): https://livetennisapi.com
LIVE_TENNIS_API_KEY=
LIVE_TENNIS_DAILY_LIMIT=100
LIVE_TENNIS_MINUTE_LIMIT=30

# Jeff Sackmann tennis datasets are CC BY-NC-SA 4.0 (NON-COMMERCIAL). Set true for any commercial use:
# the datasets are then never fetched, used by the model, or shown, and the attribution line is dropped.
TENNIS_COMMERCIAL_MODE=false
SACKMANN_ATP_BASE_URL="https://raw.githubusercontent.com/JeffSackmann/tennis_atp/master"
SACKMANN_WTA_BASE_URL="https://raw.githubusercontent.com/JeffSackmann/tennis_wta/master"
SACKMANN_HISTORY_YEARS=6
# How many days of tennis results to accumulate from API-Tennis, and the API calls spent per run (setup uses more).
TENNIS_BACKFILL_DAYS=120
TENNIS_BACKFILL_CALLS_PER_RUN=6

# --- Odds (optional, off by default). Odds are never invented: without a key no odds are shown. ---
# https://the-odds-api.com  (free plan: 500 credits/month; API-Tennis odds need that plan's odds entitlement)
FEATURE_ODDS=false
ODDS_API_KEY=
ODDS_API_MONTHLY_LIMIT=500
ODDS_API_DAILY_BUDGET=15
ODDS_API_REGIONS="us,eu"
